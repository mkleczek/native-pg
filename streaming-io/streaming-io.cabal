cabal-version: 3.0
name: streaming-io
version: 0.1.0.0
synopsis: Borrowed streams and bounded operation buffers
license: AGPL-3.0-or-later
license-file: LICENSE
build-type: Simple
extra-source-files: test/check-positive-int.sh
                    test/check-one-buffer.sh
                    test/check-no-io-waits.sh
                    test/check-steps.sh
                    test/compile/*.hs

-- The executables and test suites are linked with GHC's threaded run time. With -f-threaded they are linked with the
-- non-threaded one, which has one capability and one OS thread.
flag threaded
  description: Link the executables and test suites with the threaded run time
  default: True
  manual: True

library
  default-language: GHC2021
  hs-source-dirs: src
  -- The unfoldings are exposed and the overloaded functions specialised, so that a program that is built where its arrow
  -- is known is specialised to the arrow, in the library that uses it too.
  ghc-options: -Wall -fexpose-all-unfoldings -fspecialise-aggressively
  exposed-modules: Network.Streaming.Output
                   Network.Streaming.PositiveInt
                   Network.Streaming.BufferPool
                   Network.Streaming.Buffer
                   Network.Streaming.Watch
                   Network.Streaming.Mode
                   Network.Streaming.Annotate
                   Network.Streaming.Classes
                   Network.Streaming.Combinators
                   Network.Streaming.Plumbing
                   Network.Streaming.Counters
                   Network.Streaming.Threads
                   Network.Streaming.Delimited
                   Network.Streaming.Compiled
                   Network.Streaming.Loop
                   Network.Streaming.Simulated
                   Network.Streaming.Reader
                   Network.Streaming.With
                   Network.Streaming.Pool
                   Network.Streaming.Loans
                   Network.Streaming.NotImplemented
                   Network.Streaming.Diagram
                   Network.Streaming.Diagram.Mermaid
                   Network.Streaming.Structure
                   Network.Streaming.Lint
                   Network.Streaming.Internal.Scheduler
                   Network.Streaming.Internal.Timers
                   Network.Streaming.Internal.Cancel
                   Network.Streaming.Internal.Atomic
                   Network.Streaming.Internal.Descriptors
  other-modules: Network.Streaming.Internal.BufferPool
                 Network.Streaming.Internal.Inboxes
                 Network.Streaming.Internal.ListPrefix
                 Network.Streaming.Internal.Socket
                 Network.Streaming.Internal.Tickets
  c-sources: cbits/poller.c
  build-depends: base >=4.18 && <5, bytestring >=0.11 && <0.13, network >=3.1 && <3.3, stm >=2.5 && <2.6, containers >=0.6 && <0.8

test-suite streaming-io-spec
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test src
  main-is: Main.hs
  other-modules: ListPrefixSpec
                 DescriptorsSpec
                 GroupCostSpec
                 LoansSpec
                 LoansTestSupport
                 PoolSpec
                 PoolCostSpec
                 SetupBuffersSpec
                 SignalsSpec
                 SpecialisedSpec
                 SyscallsSpec
                 LintSpec
                 GraceSpec
                 Network.Streaming.Internal.ListPrefix
                 Network.Streaming.Output
                 Network.Streaming.PositiveInt
                 Network.Streaming.BufferPool
                 Network.Streaming.Buffer
                 Network.Streaming.Watch
                 Network.Streaming.Mode
                 Network.Streaming.Annotate
                 Network.Streaming.Classes
                 Network.Streaming.Combinators
                 Network.Streaming.Plumbing
                 Network.Streaming.Counters
                 Network.Streaming.Threads
                 Network.Streaming.Delimited
                 Network.Streaming.Compiled
                 Network.Streaming.Loop
                 Network.Streaming.Simulated
                 Network.Streaming.Reader
                 Network.Streaming.With
                 Network.Streaming.Pool
                 Network.Streaming.Loans
                 Network.Streaming.NotImplemented
                 Network.Streaming.Diagram
                 Network.Streaming.Diagram.Mermaid
                 Network.Streaming.Structure
                 Network.Streaming.Lint
                 Network.Streaming.Internal.Scheduler
                 Network.Streaming.Internal.Timers
                 Network.Streaming.Internal.Cancel
                 Network.Streaming.Internal.Atomic
                 Network.Streaming.Internal.BufferPool
                 Network.Streaming.Internal.Descriptors
                 Network.Streaming.Internal.Inboxes
                 Network.Streaming.Internal.Socket
                 Network.Streaming.Internal.Tickets
                 EmptyPoolSpec
                 InboxSpec
                 MermaidSpec
                 PositiveIntSpec
                 ResourcesSpec
                 WatchSpec
                 CoresSpec
                 RegionSpec
                 RuntimeSpec
                 ScopesSpec
                 ScopeCostSpec
                 StepCostSpec
                 StepsSpec
                 TimeSpec
                 UnwindSpec
                 WithSpec
  -- -T counts the live heap that GroupCostSpec reads.
  ghc-options: -Wall -rtsopts "-with-rtsopts=-T" -fno-omit-yields -fspecialise-aggressively -F -pgmF=skeletest-preprocessor
  if flag(threaded)
    ghc-options: -threaded
  build-tool-depends: skeletest:skeletest-preprocessor >=0.4.2 && <0.5
  build-depends: base, bytestring, containers, network, stm, streaming-io, unix, skeletest >=0.4.2 && <0.5
