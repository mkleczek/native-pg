cabal-version:      3.0
name:               native-pg-tls
version:            0.1.0.0
synopsis:           TLS for native-pg, through rustls-ffi
description:        Connects native-pg over TLS with rustls, through its C API rustls-ffi,
                    with libpq's sslmode, client certificates and SCRAM channel binding.
license:            AGPL-3.0-or-later
license-file:       LICENSE
author:             Michał Kłeczek
maintainer:         michal@kleczek.org
category:           Database, PostgreSQL
build-type:         Simple
extra-source-files: src/cbits/native-pg-tls.h
                    test/certificates/*.crt
                    test/certificates/*.key
                    test/certificates/*.crl
                    test/certificates/*.sh
tested-with:        GHC == 9.10.3, GHC == 9.12.3

library
  default-language:   GHC2021
  -- cabal builds the components with quasi-quotes with dynamic objects too,
  -- which need those of the libraries they use, so this one has them too
  default-extensions: QuasiQuotes
  hs-source-dirs:     src
  ghc-options:        -Wall
  exposed-modules:    Database.PostgreSQL.Tls
  other-modules:      Database.PostgreSQL.Tls.Internal
  c-sources:          src/cbits/native-pg-tls.c
  include-dirs:       src/cbits
  -- rustls-ffi's API changes between minor versions
  pkgconfig-depends:  rustls >= 0.15 && < 0.16
  build-depends:      base              >= 4.9 && < 4.22
                    , bytestring        >= 0.10.8 && < 0.13
                    , network           >= 3.1 && < 3.3
                    , native-pg         >= 0.1 && < 0.2
  -- rustls-ffi has no Windows package, so Windows builds go without TLS
  if os(windows)
    buildable:        False

test-suite native-pg-tls-spec
  default-language:   GHC2021
  type:               exitcode-stdio-1.0
  -- Compile the private TLS implementation for unit tests.
  hs-source-dirs:     test/tls
                     src
  other-modules:      TlsSpec
                      Database.PostgreSQL.Tls.Internal
  main-is:            Main.hs
  ghc-options:        -Wall -threaded -F -pgmF=skeletest-preprocessor
  build-tool-depends: skeletest:skeletest-preprocessor >= 0.4.2 && < 0.5
  c-sources:          src/cbits/native-pg-tls.c
  include-dirs:       src/cbits
  pkgconfig-depends:  rustls >= 0.15 && < 0.16
  build-depends:      base              >= 4.9 && < 4.22
                    , async             >= 2.1.1 && < 2.3
                    , bytestring        >= 0.10.8 && < 0.13
                    , skeletest         >= 0.4.2 && < 0.5
                    , network           >= 3.1 && < 3.3
                    , native-pg
  if os(windows)
    buildable:        False
