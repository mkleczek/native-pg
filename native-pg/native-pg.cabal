cabal-version:      3.0
name:               native-pg
version:            0.1.0.0
synopsis:           A PostgreSQL client in Haskell, without libpq
description:        Speaks PostgreSQL's protocol over a socket. It reads only when asked to,
                    so results and parameters stream in bounded memory.
license:            AGPL-3.0-or-later
license-file:       LICENSE
author:             Michał Kłeczek
maintainer:         michal@kleczek.org
category:           Database, PostgreSQL
build-type:         Simple
tested-with:        GHC == 9.10.3, GHC == 9.12.3

library
  default-language:   GHC2021
  -- cabal builds the components with quasi-quotes with dynamic objects too,
  -- which need those of the libraries they use, so this one has them too
  default-extensions: QuasiQuotes
  hs-source-dirs:     src
  ghc-options:        -Wall
  exposed-modules:    Database.PostgreSQL.Authentication
                      Database.PostgreSQL.ConnectionString
                      Database.PostgreSQL.Decoding
                      Database.PostgreSQL.Diagnostics
                      Database.PostgreSQL.Encoders
                      Database.PostgreSQL.Pipeline
                      Database.PostgreSQL.Protocol
                      Database.PostgreSQL.Protocol.Codec
                      Database.PostgreSQL.Protocol.Codec.Payload
                      Database.PostgreSQL.Protocol.Messages
                      Database.PostgreSQL.Protocol.Messages.AuthBackend
                      Database.PostgreSQL.Protocol.Messages.AuthFrontend
                      Database.PostgreSQL.Protocol.Messages.BackendSession
                      Database.PostgreSQL.Protocol.Messages.Copy
                      Database.PostgreSQL.Protocol.Messages.FrontendSession
                      Database.PostgreSQL.Protocol.Messages.MessageType
                      Database.PostgreSQL.Protocol.Messages.Parse
                      Database.PostgreSQL.Protocol.Messages.Startup
                      Database.PostgreSQL.Protocol.Messages.Types
                      Database.PostgreSQL.Session
                      Database.PostgreSQL.Snippet
                      Database.PostgreSQL.Statement
                      Database.PostgreSQL.Transaction
                      Database.PostgreSQL.Transport
  other-modules:      Data.Some
                      Database.PostgreSQL.Protocol.Codec.Input
                      Database.PostgreSQL.Protocol.Codec.Output
  build-depends:      base              >= 4.9 && < 4.22
                    , base64-bytestring >= 1 && < 1.3
                    , bytestring        >= 0.10.8 && < 0.13
                    , crypton           >= 1.0 && < 1.1
                    , directory         >= 1.2.6 && < 1.4
                    , memory            >= 0.18 && < 0.19
                    , mtl               >= 2.2.2 && < 2.4
                    , network           >= 3.1 && < 3.3
                    , postgresql-binary >= 0.14.2 && < 0.15
                    , scientific        >= 0.3 && < 0.4
                    , text              >= 1.2.2 && < 2.2
                    , time              >= 1.9 && < 2
                    , uuid              >= 1.3 && < 2

  if !os(windows)
    build-depends:
      unix

test-suite native-pg-spec
  default-language:   GHC2021
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  other-modules:      CoreSpec
                      TransportSpec
  main-is:            Main.hs
  ghc-options:        -Wall -threaded -F -pgmF=skeletest-preprocessor
  build-tool-depends: skeletest:skeletest-preprocessor >= 0.4.2 && < 0.5
  build-depends:      base              >= 4.9 && < 4.22
                    , base64-bytestring >= 1 && < 1.3
                    , bytestring        >= 0.10.8 && < 0.13
                    , skeletest         >= 0.4.2 && < 0.5
                    , memory            >= 0.18 && < 0.19
                    , text              >= 1.2.2 && < 2.2
                    , native-pg
