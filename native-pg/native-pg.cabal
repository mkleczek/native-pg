cabal-version:      3.0
name:               native-pg
version:            0.1.0.0
synopsis:           A PostgreSQL client in Haskell, without libpq
description:        Speaks PostgreSQL's protocol over a socket. It reads only when asked to,
                    so results and parameters stream in bounded memory.
license:            AGPL-3.0-or-later
license-file:       LICENSE
author:             Michał Kłeczek
maintainer:         michal@kleczek.org
category:           Database, PostgreSQL
build-type:         Simple
tested-with:        GHC == 9.10.3, GHC == 9.12.3
extra-source-files: THIRD-PARTY-NOTICES
                    test/check-api-boundary.sh
                    test/api-boundary/Client.hs

common implementation
  default-language:   GHC2021
  default-extensions: QuasiQuotes
  hs-source-dirs:     src
  ghc-options:        -Wall
  other-modules:      Database.PostgreSQL.Internal.Authentication
                      Database.PostgreSQL.Internal.Channel
                      Database.PostgreSQL.Internal.Context
                      Database.PostgreSQL.Internal.Diagnostics
                      Database.PostgreSQL.Internal.Exchange
                      Database.PostgreSQL.Internal.Execution
                      Database.PostgreSQL.Internal.HostSelection
                      Database.PostgreSQL.Internal.PoolLifetime
                      Database.PostgreSQL.Internal.Protocol
                      Database.PostgreSQL.Internal.Protocol.Codec
                      Database.PostgreSQL.Internal.Protocol.Codec.Input
                      Database.PostgreSQL.Internal.Protocol.Codec.Output
                      Database.PostgreSQL.Internal.Protocol.Codec.Payload
                      Database.PostgreSQL.Internal.Protocol.Messages
                      Database.PostgreSQL.Internal.Protocol.Messages.AuthBackend
                      Database.PostgreSQL.Internal.Protocol.Messages.AuthFrontend
                      Database.PostgreSQL.Internal.Protocol.Messages.BackendSession
                      Database.PostgreSQL.Internal.Protocol.Messages.Copy
                      Database.PostgreSQL.Internal.Protocol.Messages.FrontendSession
                      Database.PostgreSQL.Internal.Protocol.Messages.MessageType
                      Database.PostgreSQL.Internal.Protocol.Messages.Parse
                      Database.PostgreSQL.Internal.Protocol.Messages.Startup
                      Database.PostgreSQL.Internal.Protocol.Messages.Types
                      Database.PostgreSQL.Internal.Row
                      Database.PostgreSQL.Internal.Socket
                      Database.PostgreSQL.Internal.Socket.Link
                      Database.PostgreSQL.Internal.Some
                      Database.PostgreSQL.Internal.Startup
  build-depends:      base              >= 4.9 && < 4.22
                    , base64-bytestring >= 1 && < 1.3
                    , bytestring        >= 0.10.8 && < 0.13
                    , crypton           >= 1.0 && < 1.1
                    , directory         >= 1.2.6 && < 1.4
                    , memory            >= 0.18 && < 0.19
                    , mtl               >= 2.2.2 && < 2.4
                    , network           >= 3.1 && < 3.3
                    , postgresql-binary >= 0.14.2 && < 0.15
                    , resource-admission
                    , stm
                    , streaming-io
                    , scientific        >= 0.3 && < 0.4
                    , text              >= 1.2.2 && < 2.2
                    , time              >= 1.9 && < 2
                    , unliftio-core     >= 0.2 && < 0.3
                    , uuid              >= 1.3 && < 2

  if !os(windows)
    build-depends:
      unix

library
  import:             implementation
  exposed-modules:    Database.PostgreSQL.ConnectionString
                      Database.PostgreSQL.ConnectionString.Types
                      Database.PostgreSQL.Decoding
                      Database.PostgreSQL.Diagnostics
                      Database.PostgreSQL.Encoders
                      Database.PostgreSQL.Pool
                      Database.PostgreSQL.Pool.Observation
                      Database.PostgreSQL.Session
                      Database.PostgreSQL.Session.Settings
                      Database.PostgreSQL.Snippet
                      Database.PostgreSQL.Streaming
                      Database.PostgreSQL.Streaming.Types
                      Database.PostgreSQL.Transaction
                      Database.PostgreSQL.Transport
                      Database.PostgreSQL.Transport.Link
                      Database.PostgreSQL.Types

test-suite native-pg-spec
  import:             implementation
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  other-modules:      Database.PostgreSQL.ConnectionString
                      Database.PostgreSQL.ConnectionString.Types
                      Database.PostgreSQL.Decoding
                      Database.PostgreSQL.Diagnostics
                      Database.PostgreSQL.Encoders
                      Database.PostgreSQL.Pool
                      Database.PostgreSQL.Pool.Observation
                      Database.PostgreSQL.Session
                      Database.PostgreSQL.Session.Settings
                      Database.PostgreSQL.Snippet
                      Database.PostgreSQL.Streaming
                      Database.PostgreSQL.Streaming.Types
                      Database.PostgreSQL.Transaction
                      Database.PostgreSQL.Transport
                      Database.PostgreSQL.Transport.Link
                      Database.PostgreSQL.Types
                      PoolAdmissionSpec
                      PoolSpec
                      PoolReservationSpec
                      BorrowedOutputSpec
                      BorrowingSpec
                      CoreSpec
                      ContextSpec
                      FramingSpec
                      StreamingResourcesSpec
                      FieldStreamSpec
                      TransactionSpec
                      OutputBufferSpec
                      TransportSpec
  main-is:            Main.hs
  ghc-options:        -Wall -threaded -F -pgmF=skeletest-preprocessor
  build-tool-depends: skeletest:skeletest-preprocessor >= 0.4.2 && < 0.5
  -- Whitebox tests compile the sources so hidden modules stay unavailable
  -- to clients without requiring a separate implementation library.
  build-depends:      skeletest >= 0.4.2 && < 0.5
                    , stm
