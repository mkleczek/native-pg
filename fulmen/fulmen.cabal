cabal-version: 3.0
name: fulmen
version: 0.1.0.0
synopsis: An HTTP/1.1 server on the arrow runtime of streaming-io
description: Serves HTTP/1.1 from connection workers that are spawned as connections are accepted, a group for each
             core, with bodies read and written as views of the request's buffers, so that a request in flight
             works in bounded memory.
license: AGPL-3.0-or-later
license-file: LICENSE
build-type: Simple

-- The executables and test suites are linked with GHC's threaded run time. With -f-threaded they are linked with the
-- non-threaded one, which has one capability and one OS thread.
flag threaded
  description: Link the executables and test suites with the threaded run time
  default: True
  manual: True

library
  default-language: GHC2021
  hs-source-dirs: src
  -- The unfoldings are exposed and the overloaded functions specialised, so that a program that is built where its arrow
  -- is known is specialised to the arrow.
  ghc-options: -Wall -fexpose-all-unfoldings -fspecialise-aggressively
  exposed-modules: Network.Fulmen
                   Network.Fulmen.Listen
                   Network.Fulmen.Request
                   Network.Fulmen.Response
                   Network.Fulmen.Shutdown
  other-modules: Network.Fulmen.Internal
                 Network.Fulmen.Internal.Accept
                 Network.Fulmen.Internal.Body
                 Network.Fulmen.Internal.Bytes
                 Network.Fulmen.Internal.Date
                 Network.Fulmen.Internal.Head
                 Network.Fulmen.Internal.Response
                 Network.Fulmen.Internal.Serve
  c-sources: cbits/signals.c
  build-depends: base >=4.18 && <5, bytestring >=0.11 && <0.13, containers, network >=3.1 && <3.3, streaming-io

-- The HTTP/1.1 conformance cases, which are data of bytes in and bytes out, run against a
-- server that the suite starts for each case. The cases that need a part of the server that is
-- not there yet are marked as expected failures. The suite checks as well how the server shares new connections out between
-- the cores.
test-suite fulmen-conformance
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  other-modules: ConformanceCases
                 ConformanceSpec
                 ConformanceWire
                 PlacementSpec
  ghc-options: -Wall -fspecialise-aggressively -F -pgmF=skeletest-preprocessor
  if flag(threaded)
    ghc-options: -threaded
  -- The server of the bench runs in a process of its own, under a small stack, for the case of a server of thousands of
  -- connection workers.
  build-tool-depends: skeletest:skeletest-preprocessor >=0.4.2 && <0.5, fulmen:fulmen-bench
  build-depends: base, bytestring, directory, fulmen, network, process, streaming-io, skeletest >=0.4.2 && <0.5, unix

-- A quick measurement: a client of C keep-alive connections and a server that answers with a static body, run as two
-- processes of this one program. Its numbers are for looking at, and nothing checks them.
executable fulmen-bench
  default-language: GHC2021
  hs-source-dirs: bench
  main-is: Main.hs
  ghc-options: -Wall -rtsopts -fspecialise-aggressively
  if flag(threaded)
    ghc-options: -threaded
  build-depends: base, bytestring, fulmen, network, streaming-io

-- Draws the server as Mermaid flowcharts, one for each named box of its program, with the program built at the arrow that
-- runs nothing. It writes them into the directory that is its argument.
executable fulmen-diagram
  default-language: GHC2021
  hs-source-dirs: diagram program
  main-is: Main.hs
  other-modules: ServerProgram
  ghc-options: -Wall
  build-depends: base, fulmen, streaming-io

-- The lint of the structure of the server's program, built at the arrow that runs nothing. It fails on a finding that no
-- part of the program allows.
test-suite fulmen-lint
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: lint program
  main-is: Main.hs
  other-modules: ServerLintSpec
                 ServerProgram
  ghc-options: -Wall -F -pgmF=skeletest-preprocessor
  build-tool-depends: skeletest:skeletest-preprocessor >=0.4.2 && <0.5
  build-depends: base, fulmen, streaming-io, skeletest >=0.4.2 && <0.5
