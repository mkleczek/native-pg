cabal-version: 3.0
name: fulmen
version: 0.1.0.0
synopsis: An HTTP/1.1 server on the arrow runtime of streaming-io
description: Serves HTTP/1.1 from a fixed network of parts that are made at startup, per core, with
             bodies read and written as views of the request's buffers, so that a request in flight
             works in bounded memory.
license: AGPL-3.0-or-later
license-file: LICENSE
build-type: Simple

library
  default-language: GHC2021
  hs-source-dirs: src
  ghc-options: -Wall
  exposed-modules: Network.Fulmen
                   Network.Fulmen.Request
                   Network.Fulmen.Response
  other-modules: Network.Fulmen.Internal
                 Network.Fulmen.Internal.Accept
                 Network.Fulmen.Internal.Body
                 Network.Fulmen.Internal.Bytes
                 Network.Fulmen.Internal.Date
                 Network.Fulmen.Internal.Head
                 Network.Fulmen.Internal.Response
                 Network.Fulmen.Internal.Serve
  build-depends: base >=4.18 && <5, bytestring >=0.11 && <0.13, network >=3.1 && <3.3, streaming-io

-- The HTTP/1.1 conformance cases, which are data of bytes in and bytes out, run against a
-- server that the suite starts for each case. The cases that need a part of the server that is
-- not there yet are marked as expected failures.
test-suite fulmen-conformance
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  other-modules: ConformanceCases
                 ConformanceSpec
                 ConformanceWire
  ghc-options: -Wall -threaded -F -pgmF=skeletest-preprocessor
  build-tool-depends: skeletest:skeletest-preprocessor >=0.4.2 && <0.5
  build-depends: base, bytestring, fulmen, network, streaming-io, skeletest >=0.4.2 && <0.5

-- A quick measurement: a client of C keep-alive connections and a server that answers with a static body, run as two
-- processes of this one program. Its numbers are for looking at, and nothing checks them.
executable fulmen-bench
  default-language: GHC2021
  hs-source-dirs: bench
  main-is: Main.hs
  ghc-options: -Wall -threaded -rtsopts
  build-depends: base, bytestring, fulmen, network, streaming-io
